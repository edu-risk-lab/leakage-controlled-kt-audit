\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Sequence Autocorrelation Analysis}{16}{subsection.4.2}\protected@file@percent }
\newlabel{sec:exp-autocorr}{{4.2}{16}{Sequence Autocorrelation Analysis}{subsection.4.2}{}}
\newlabel{sec:exp-autocorr@cref}{{[subsection][2][4]4.2}{[1][16][]16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Consecutive KC-repeat rate against KT performance, with datasets ordered by ascending repeat rate. As the share of consecutive interactions that reuse the previous knowledge component{} rises ($0.21\!\to \!0.66\!\to \!0.75$), the deep sequence model \textit  {simpleKT} climbs from $0.87$ to $0.98$ AUC (train-only checkpoints), whereas an independent-skill BKT---which cannot exploit the repetition shortcut as aggressively---stays far lower. Regenerated by \path {scripts/plot_autocorrelation.py} from \path {results/tables/autocorrelation_stats.csv} and \path {results/tables/baseline_results.csv}.}}{17}{figure.caption.21}\protected@file@percent }
\newlabel{fig:autocorr-auc}{{3}{17}{Consecutive KC-repeat rate against KT performance, with datasets ordered by ascending repeat rate. As the share of consecutive interactions that reuse the previous \KC {} rises ($0.21\!\to \!0.66\!\to \!0.75$), the deep sequence model \textit {simpleKT} climbs from $0.87$ to $0.98$ AUC (train-only checkpoints), whereas an independent-skill BKT---which cannot exploit the repetition shortcut as aggressively---stays far lower. Regenerated by \protect \path {scripts/plot_autocorrelation.py} from \protect \path {results/tables/autocorrelation_stats.csv} and \protect \path {results/tables/baseline_results.csv}}{figure.caption.21}{}}
\newlabel{fig:autocorr-auc@cref}{{[figure][3][]3}{[1][16][]17}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Direct leakage diagnostics per dataset (fold mean where multiple folds are present). \textsc  {ECR}\textsubscript  {flag}: learner-overlap structural indicator (Eq.~\ref {eq:ecr-flag}; $0$ confirms disjoint learners across train/validation/test under each fold). \textsc  {ECR}\textsubscript  {overlap}: held-out pattern overlap rate over retained edges (Eq.~\ref {eq:ecr-overlap}). \textsc  {EOC}: Edge--Outcome Correlation Frobenius norm (Eq.~\ref {eq:eoc}); \textsc  {TBVR}: Temporal Boundary Violation Rate within train timelines (Eq.~\ref {eq:tbvr}, indexed boundary). Values are exported by \texttt  {p0-graph-build} into \texttt  {results/tables/leakage\_metrics.csv}. Under learner-disjoint folds, $\textsc  {ECR}\textsubscript  {flag}{=}0$ on every run---confirming structural leakage freedom at the split level; \textsc  {ECR}\textsubscript  {overlap} can remain near~$1$ on dense logs because recurrent transition patterns reappear across disjoint held-out learners (diagnostic overlap, not \texttt  {train\_only\_flag} violation).}}{18}{table.caption.23}\protected@file@percent }
\newlabel{tab:leakage-metrics}{{4}{18}{Direct leakage diagnostics per dataset (fold mean where multiple folds are present). \textsc {ECR}\textsubscript {flag}: learner-overlap structural indicator (Eq.~\ref {eq:ecr-flag}; $0$ confirms disjoint learners across train/validation/test under each fold). \textsc {ECR}\textsubscript {overlap}: held-out pattern overlap rate over retained edges (Eq.~\ref {eq:ecr-overlap}). \textsc {EOC}: Edge--Outcome Correlation Frobenius norm (Eq.~\ref {eq:eoc}); \textsc {TBVR}: Temporal Boundary Violation Rate within train timelines (Eq.~\ref {eq:tbvr}, indexed boundary). Values are exported by \texttt {p0-graph-build} into \texttt {results/tables/leakage\_metrics.csv}. Under learner-disjoint folds, $\textsc {ECR}\textsubscript {flag}{=}0$ on every run---confirming structural leakage freedom at the split level; \textsc {ECR}\textsubscript {overlap} can remain near~$1$ on dense logs because recurrent transition patterns reappear across disjoint held-out learners (diagnostic overlap, not \texttt {train\_only\_flag} violation)}{table.caption.23}{}}
\newlabel{tab:leakage-metrics@cref}{{[table][4][]4}{[1][18][]18}{}{}{}}
