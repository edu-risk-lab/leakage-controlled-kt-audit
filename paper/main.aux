\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Sequence-autocorrelation diagnostics on the three public benchmarks. \emph  {KC rep.} and \emph  {Item rep.} are the fractions of consecutive within-learner interactions that repeat the previous KC or item; \emph  {Persist.\ acc.} is $P(y_t{=}y_{t-1})$; \emph  {Lag-1 $\rho $} is the lag-one label autocorrelation; \emph  {Prev-AUC} is the AUC of the trivial predictor $\hat  y_t{=}y_{t-1}$.}}{16}{table.caption.20}\protected@file@percent }
