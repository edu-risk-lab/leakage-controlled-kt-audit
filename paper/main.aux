\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Research framework connecting protocol modules (Section~\ref {sec:protocol}) and experiment tracks (Section~\ref {sec:exp}). \textbf  {Strengths:} fold-conditioned provenance, explicit DAG repair, structural diagnostics decoupled from AUC, optional expert cross-validation. \textbf  {Limitations:} fixed behavioural inference rule; similarity rule fails on single-skill Q-matrices; downstream \textsc  {DDR}{} retraining is currently reported for DGEKT on ASSISTments/XES3G5M rather than for every graph-KT backbone; GT CV available only where expert graphs exist.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:framework}{{2}{7}{Research framework connecting protocol modules (Section~\ref {sec:protocol}) and experiment tracks (Section~\ref {sec:exp}). \textbf {Strengths:} fold-conditioned provenance, explicit DAG repair, structural diagnostics decoupled from AUC, optional expert cross-validation. \textbf {Limitations:} fixed behavioural inference rule; similarity rule fails on single-skill Q-matrices; downstream \DDR {} retraining is currently reported for DGEKT on ASSISTments/XES3G5M rather than for every graph-KT backbone; GT CV available only where expert graphs exist}{figure.caption.8}{}}
\newlabel{fig:framework@cref}{{[figure][2][]2}{[1][6][]7}{}{}{}}
