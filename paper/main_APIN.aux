\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textsc  {DDR}{} as a function of perturbation strength $p$ on Junyi Academy for five graph augmentation families: four label-agnostic operators (\texttt  {attr\_mask}, \texttt  {subgraph}, \texttt  {edge\_drop}, \texttt  {node\_drop}) and one prerequisite-preserving operator (\texttt  {prereq\_preserve}). Each marker plots the mean \textsc  {DDR}{} averaged across nine stochastic runs (three random seeds on each of three train folds). The same ordering holds on ASSISTments~2012 and XES3G5M (Supplementary Figure~S2): $\textsc  {DDR}(\text  {attr\_mask})=0 < \textsc  {DDR}(\text  {subgraph}) \lesssim \textsc  {DDR}(\text  {prereq\_preserve}) < \textsc  {DDR}(\text  {edge\_drop}) \approx p < \textsc  {DDR}(\text  {node\_drop})$.}}{20}{figure.caption.36}\protected@file@percent }
\newlabel{fig:ddr-junyi}{{4}{20}{\DDR {} as a function of perturbation strength $p$ on Junyi Academy for five graph augmentation families: four label-agnostic operators (\texttt {attr\_mask}, \texttt {subgraph}, \texttt {edge\_drop}, \texttt {node\_drop}) and one prerequisite-preserving operator (\texttt {prereq\_preserve}). Each marker plots the mean \DDR {} averaged across nine stochastic runs (three random seeds on each of three train folds). The same ordering holds on ASSISTments~2012 and XES3G5M (Supplementary Figure~S2): $\DDR (\text {attr\_mask})=0 < \DDR (\text {subgraph}) \lesssim \DDR (\text {prereq\_preserve}) < \DDR (\text {edge\_drop}) \approx p < \DDR (\text {node\_drop})$}{figure.caption.36}{}}
\newlabel{fig:ddr-junyi@cref}{{[figure][4][]4}{[1][19][]20}{}{}{}}
