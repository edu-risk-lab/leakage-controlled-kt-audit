\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Mean \textsc  {DDR}{} across three seeds and three train folds for the five augmentation families and four perturbation strengths. Subgraph sampling is random-walk based (Section~\ref {sec:ddr}); \texttt  {prereq\_preserve} is the prerequisite-preserving operator that, at the same per-edge budget as \texttt  {edge\_drop}, removes only transitively redundant edges and protects the transitive-reduction backbone. Lower is less disruptive; $0.000$ for attribute masking is by construction.}}{21}{table.caption.38}\protected@file@percent }
\newlabel{tab:ddr-raw}{{8}{21}{Mean \DDR {} across three seeds and three train folds for the five augmentation families and four perturbation strengths. Subgraph sampling is random-walk based (Section~\ref {sec:ddr}); \texttt {prereq\_preserve} is the prerequisite-preserving operator that, at the same per-edge budget as \texttt {edge\_drop}, removes only transitively redundant edges and protects the transitive-reduction backbone. Lower is less disruptive; $0.000$ for attribute masking is by construction}{table.caption.38}{}}
\newlabel{tab:ddr-raw@cref}{{[table][8][]8}{[1][19][]21}{}{}{}}
