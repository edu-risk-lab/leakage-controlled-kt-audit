\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Illustrative comparison of graph construction workflows. \textbf  {(a)}~Pooling the full log before edge inference lets held-out transitions influence $G$ even when the KT optimiser sees only the train fold. \textbf  {(b)}~Our protocol builds a fold-specific graph $G_f$ from train-only interactions. When train folds are large, edge inference may use a representative train-only sample $\tilde  {\mathcal  {I}}^f_{\text  {tr}}\subseteq \mathcal  {F}^f_{\text  {train}}$ (optional; Section~\ref {sec:graph}) to bound compute while preserving leakage control; reported benchmarks use the full train fold.}}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:intro-leakage}{{1}{3}{Illustrative comparison of graph construction workflows. \textbf {(a)}~Pooling the full log before edge inference lets held-out transitions influence $G$ even when the KT optimiser sees only the train fold. \textbf {(b)}~Our protocol builds a fold-specific graph $G_f$ from train-only interactions. When train folds are large, edge inference may use a representative train-only sample $\tilde {\mathcal {I}}^f_{\text {tr}}\subseteq \mathcal {F}^f_{\text {train}}$ (optional; Section~\ref {sec:graph}) to bound compute while preserving leakage control; reported benchmarks use the full train fold}{figure.caption.2}{}}
\newlabel{fig:intro-leakage@cref}{{[figure][1][]1}{[1][3][]3}{}{}{}}
