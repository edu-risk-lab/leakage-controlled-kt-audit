\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Direct leakage diagnostics per dataset (fold mean where multiple folds are present). \textsc  {ECR}\textsubscript  {flag}: learner-overlap structural indicator (Eq.~\ref {eq:ecr-flag}; $0$ confirms disjoint learners across train/validation/test under each fold). \textsc  {ECR}\textsubscript  {overlap}: held-out pattern overlap rate over retained edges (Eq.~\ref {eq:ecr-overlap}). \textsc  {EOC}: Edge--Outcome Correlation Frobenius norm (Eq.~\ref {eq:eoc}); \textsc  {TBVR}: Temporal Boundary Violation Rate within train timelines (Eq.~\ref {eq:tbvr}, indexed boundary). Values are exported by \texttt  {p0-graph-build} into \texttt  {results/tables/leakage\_metrics.csv}. Under learner-disjoint folds, $\textsc  {ECR}\textsubscript  {flag}{=}0$ on every run---confirming structural leakage freedom at the split level; \textsc  {ECR}\textsubscript  {overlap} can remain near~$1$ on dense logs because recurrent transition patterns reappear across disjoint held-out learners (diagnostic overlap, not \texttt  {train\_only\_flag} violation).}}{16}{table.caption.20}\protected@file@percent }
\newlabel{tab:leakage-metrics}{{3}{16}{Direct leakage diagnostics per dataset (fold mean where multiple folds are present). \textsc {ECR}\textsubscript {flag}: learner-overlap structural indicator (Eq.~\ref {eq:ecr-flag}; $0$ confirms disjoint learners across train/validation/test under each fold). \textsc {ECR}\textsubscript {overlap}: held-out pattern overlap rate over retained edges (Eq.~\ref {eq:ecr-overlap}). \textsc {EOC}: Edge--Outcome Correlation Frobenius norm (Eq.~\ref {eq:eoc}); \textsc {TBVR}: Temporal Boundary Violation Rate within train timelines (Eq.~\ref {eq:tbvr}, indexed boundary). Values are exported by \texttt {p0-graph-build} into \texttt {results/tables/leakage\_metrics.csv}. Under learner-disjoint folds, $\textsc {ECR}\textsubscript {flag}{=}0$ on every run---confirming structural leakage freedom at the split level; \textsc {ECR}\textsubscript {overlap} can remain near~$1$ on dense logs because recurrent transition patterns reappear across disjoint held-out learners (diagnostic overlap, not \texttt {train\_only\_flag} violation)}{table.caption.20}{}}
\newlabel{tab:leakage-metrics@cref}{{[table][3][]3}{[1][15][]16}{}{}{}}
