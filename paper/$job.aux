\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Direct leakage diagnostics per dataset (fold mean where multiple folds are present). \textsc  {ECR}\textsubscript  {flag}: learner-overlap structural indicator (Eq.~\ref {eq:ecr-flag}; $0$ confirms disjoint learners across train/validation/test under each fold). \textsc  {ECR}\textsubscript  {overlap}: held-out pattern overlap rate over retained edges (Eq.~\ref {eq:ecr-overlap}). \textsc  {EOC}: Edge--Outcome Correlation Frobenius norm (Eq.~\ref {eq:eoc}); \textsc  {TBVR}: Temporal Boundary Violation Rate within train timelines (Eq.~\ref {eq:tbvr}, indexed boundary). Values are exported by \texttt  {p0-graph-build} into \texttt  {results/tables/leakage\_metrics.csv}. Under learner-disjoint folds, $\textsc  {ECR}\textsubscript  {flag}{=}0$ on every run---confirming structural leakage freedom at the split level; \textsc  {ECR}\textsubscript  {overlap} can remain near~$1$ on dense logs because recurrent transition patterns reappear across disjoint held-out learners (diagnostic overlap, not \texttt  {train\_only\_flag} violation).}}{8}{table.caption.5}\protected@file@percent }
\newlabel{tab:leakage-metrics}{{III}{8}{Direct leakage diagnostics per dataset (fold mean where multiple folds are present). \textsc {ECR}\textsubscript {flag}: learner-overlap structural indicator (Eq.~\ref {eq:ecr-flag}; $0$ confirms disjoint learners across train/validation/test under each fold). \textsc {ECR}\textsubscript {overlap}: held-out pattern overlap rate over retained edges (Eq.~\ref {eq:ecr-overlap}). \textsc {EOC}: Edge--Outcome Correlation Frobenius norm (Eq.~\ref {eq:eoc}); \textsc {TBVR}: Temporal Boundary Violation Rate within train timelines (Eq.~\ref {eq:tbvr}, indexed boundary). Values are exported by \texttt {p0-graph-build} into \texttt {results/tables/leakage\_metrics.csv}. Under learner-disjoint folds, $\textsc {ECR}\textsubscript {flag}{=}0$ on every run---confirming structural leakage freedom at the split level; \textsc {ECR}\textsubscript {overlap} can remain near~$1$ on dense logs because recurrent transition patterns reappear across disjoint held-out learners (diagnostic overlap, not \texttt {train\_only\_flag} violation)}{table.caption.5}{}}
\newlabel{tab:leakage-metrics@cref}{{[table][3][]III}{[1][8][]8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces DAG audit summary (fold~0). \emph  {Raw} and \emph  {Final} are the prerequisite edge counts before and after lowest-confidence cycle pruning inside \texttt  {dag\_audit}; \emph  {Pruned} is the difference. The \emph  {Cycles} column reports representative cycles found before pruning (cap~$100$). All corpora pass topological sort with zero cycles after pruning on fold~0.}}{8}{table.caption.6}\protected@file@percent }
