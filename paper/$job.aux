\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Research framework connecting protocol modules (Section~\ref {sec:protocol}) and experiment tracks (Section~\ref {sec:exp}). \textbf  {Strengths:} fold-conditioned provenance, explicit DAG repair, structural diagnostics decoupled from AUC, optional expert cross-validation. \textbf  {Limitations:} fixed behavioural inference rule; similarity rule fails on single-skill Q-matrices; \textsc  {DDR}{} covers only four generic augmentations; GT CV available only where expert graphs exist.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:framework}{{2}{4}{Research framework connecting protocol modules (Section~\ref {sec:protocol}) and experiment tracks (Section~\ref {sec:exp}). \textbf {Strengths:} fold-conditioned provenance, explicit DAG repair, structural diagnostics decoupled from AUC, optional expert cross-validation. \textbf {Limitations:} fixed behavioural inference rule; similarity rule fails on single-skill Q-matrices; \DDR {} covers only four generic augmentations; GT CV available only where expert graphs exist}{figure.caption.2}{}}
