# ---------------------------------------------------------------------------
Checklist/_*.py
Checklist/_*.png
Checklist/_*.txt
Checklist/_*.json
audit/**/_*.txt
audit/**/_*.png
audit/**/*_page*.png

# Secrets / local env
.env
.env.*
*.pem
